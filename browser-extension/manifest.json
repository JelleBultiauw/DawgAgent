{
  "manifest_version": 3,
  "name": "DawgAgent Browser",
  "version": "1.1.0",
  "description": "Laat DawgAgent je eigen Chrome lezen en bedienen — met paginatekst en genummerde elementen in plaats van dure screenshots. Met zijpaneel dat je actieve tab volgt.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "alarms", "storage", "debugger", "sidePanel"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "DawgAgent — zijpaneel openen" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
